{
  "name": "@n4/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch --conditions=source --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@n4/engine": "workspace:*",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@n4/board-sim": "workspace:*",
    "@n4/wled-sim": "workspace:*",
    "@types/ws": "8.18.2"
  },
  "exports": {
    "./api": {
      "source": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  }
}
