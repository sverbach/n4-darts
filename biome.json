{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/dist", "!.scratch", "!prototypes"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["packages/web/src/features/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../../**", "../../features/**"],
                    "message": "A feature never imports from another feature (docs/architecture/05-building-block-view.md, 5.2). Shared between features? Move it to components/ or lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/web/src/features/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../../../**", "../../../features/**"],
                    "message": "A feature never imports from another feature (docs/architecture/05-building-block-view.md, 5.2). Shared between features? Move it to components/ or lib/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
