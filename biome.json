{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!.scratch", "!prototypes", "!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/web/src/features/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../../**", "../../features/**"],
                    "message": "A feature never imports from another feature (docs/architecture/05-building-block-view.md, 5.2). Shared between features? Move it to components/ or lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/web/src/features/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../../../**", "../../../features/**"],
                    "message": "A feature never imports from another feature (docs/architecture/05-building-block-view.md, 5.2). Shared between features? Move it to components/ or lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/src/**",
        "!packages/web/src/lib/**",
        "!packages/web/src/**/*.test.ts",
        "!packages/web/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Server data goes through lib/ (docs/architecture/08-crosscutting-concepts.md): useLive to follow a view, useFetch to read once, request() or call() for a change.",
                  "EventSource": "Live views go through useLive in lib/ (docs/architecture/08-crosscutting-concepts.md)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/server/src/**",
        "!packages/server/src/**/*Routes.ts",
        "!packages/server/src/app.ts",
        "!packages/server/src/api.ts",
        "!packages/server/src/parse.ts",
        "!packages/server/src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["fastify", "@fastify/*"],
                    "message": "Logic has no HTTP in it (docs/architecture/05-building-block-view.md, 5.2): routes go in the component's *Routes.ts."
                  },
                  {
                    "group": ["zod", "zod/*"],
                    "message": "Requests are parsed in the routes files (docs/adr/0010): schemas go in api.ts, the helpers in parse.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/server/src/api.ts", "packages/server/src/parse.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["fastify", "@fastify/*"],
                    "message": "Logic has no HTTP in it (docs/architecture/05-building-block-view.md, 5.2): routes go in the component's *Routes.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/server/src/**",
        "!packages/server/src/**/*Routes.ts",
        "!packages/server/src/app.ts",
        "!packages/server/src/api.ts",
        "!packages/server/src/parse.ts",
        "!packages/server/src/db.ts",
        "!packages/server/src/testing/**",
        "!packages/server/src/**/*.test.ts"
      ],
      "plugins": ["./lint/typed-logic.grit"]
    },
    {
      "includes": ["packages/server/src/**/*Routes.ts", "packages/server/src/app.ts"],
      "plugins": ["./lint/no-route-generics.grit"]
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
