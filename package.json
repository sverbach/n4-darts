{
  "name": "n4-darts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @n4/e2e e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "pnpm -r --parallel dev",
    "start": "node packages/server/dist/main.js",
    "sim": "pnpm --filter @n4/board-sim sim",
    "db:reset": "rm -f packages/server/data/n4-darts.db* && echo 'dev database cleared'",
    "dev:sim": "STATIONS=1=http://localhost:3180,2=http://localhost:3181 pnpm -r --parallel run \"/^dev(:sim)?$/\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
